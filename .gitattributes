# Normalize line endings so re-running the converter (scripts write LF) never
# shows a spurious CRLF<->LF diff on otherwise-unchanged files.
*.mdx   text eol=lf
*.md    text eol=lf
*.mjs   text eol=lf
*.js    text eol=lf
*.py    text eol=lf
*.json  text eol=lf
*.tsv   text eol=lf
# Every tracked .yml blob is already LF in the index; without this attribute a
# Windows checkout materialised CRLF bytes and any sha256 pinned over the file
# (e.g. grammar-lab manifest feeds) disagreed between platforms.
*.yml   text eol=lf
*.yaml  text eol=lf

# Binary assets — never touch line endings / never diff
*.doc   binary
*.docx  binary
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
