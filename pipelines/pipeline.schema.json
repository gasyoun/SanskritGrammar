{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gasyoun.github.io/SanskritGrammar/contracts/pipeline.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "owner", "generator", "inputs", "outputs", "checks", "external_consumers", "rollback", "steps"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "owner": {"type": "string", "minLength": 1},
    "generator": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "outputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "checks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "external_consumers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "rollback": {"type": "object", "additionalProperties": false, "required": ["command"], "properties": {"command": {"$ref": "#/$defs/command"}}},
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}
  },
  "$defs": {
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "version", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "command"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "command": {"$ref": "#/$defs/command"},
        "cwd": {"type": "string", "minLength": 1},
        "needs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "inputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "outputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}

