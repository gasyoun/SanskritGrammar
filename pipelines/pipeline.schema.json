{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gasyoun/SanskritGrammar/blob/main/pipelines/pipeline.schema.json",
  "title": "SanskritGrammar pipeline manifest (contract_version 1)",
  "description": "Declarative build graph. Orchestration only: a manifest never carries executable Python or shell text. Step commands resolve to registered sg_tooling operations. See docs/ARCHITECTURE_SANSKRITGRAMMAR_MODULAR_MONOREPO.md section 6.2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "pipeline_id",
    "owner",
    "context",
    "steps",
    "verification",
    "rollback"
  ],
  "properties": {
    "contract_version": {
      "const": 1,
      "description": "Major contract revision. Additive optional fields stay within version 1."
    },
    "pipeline_id": {
      "type": "string",
      "pattern": "^pipeline:[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable semantic identity, never path-derived."
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "description": "Exactly one accountable owner."
    },
    "context": {
      "type": "string",
      "pattern": "^(work|sangram|repo):[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "The bounded context this pipeline writes inside."
    },
    "generator": {
      "type": "string",
      "minLength": 1,
      "description": "Registered generator namespace backing this pipeline's steps."
    },
    "description": { "type": "string" },
    "inputs": {
      "type": "array",
      "description": "Explicit declared inputs. External inputs pin an immutable revision and hash.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rights"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "provenance_id": {
            "type": "string",
            "pattern": "^external:[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Reference into data/provenance.lock.json for an external input."
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "version": { "type": "string", "minLength": 1 },
          "rights": { "$ref": "#/$defs/rights" }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "outputs"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "command": {
            "type": "string",
            "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$",
            "description": "Registered sg_tooling operation name, never shell text."
          },
          "needs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
            "uniqueItems": true
          },
          "inputs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "options": {
            "type": "object",
            "description": "Declarative option map passed to the registered command. No shell fragments.",
            "additionalProperties": {
              "type": ["string", "number", "boolean", "null"]
            }
          }
        }
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Named verification operations that must pass for this pipeline."
    },
    "external_consumers": {
      "type": "array",
      "description": "Known consumers of this pipeline's outputs. An existing consumer whose owner or contract is unknown is a stop condition, not an entry here.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "owner", "contract", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "repo": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "contract": { "type": "string", "minLength": 1 },
          "smoke": { "type": "string", "minLength": 1 },
          "rollback": { "type": "string", "minLength": 1 },
          "status": {
            "enum": ["prepared", "verified", "merged", "retired"]
          }
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["procedure"],
      "properties": {
        "procedure": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 7 },
        "artifact": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "rights": {
      "enum": [
        "publishable",
        "publishable-derived-input",
        "restricted-source",
        "per-file",
        "unknown"
      ],
      "description": "A rights class. 'unknown' is representable and is not a validation failure, but it never grants publication permission: the publication gate fails closed on anything that is not publication-safe."
    }
  }
}
